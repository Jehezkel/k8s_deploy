@using System.Globalization
@using KDS.Dashboard.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject RunArchive Archive
@inject IJSRuntime JS

<section class="timeline" aria-label="Oś czasu ruchu i deployów">
    <header>
        <div><span class="eyebrow">OBSERWACJA ŚRODOWISKA</span><h2>Ruch i deploye <span class="live @(_live ? "active" : "")">@(_live ? "NA ŻYWO" : _playing ? "ODTWARZANIE" : "ZATRZYMANO")</span></h2></div>
        <div class="controls">
            <select aria-label="Przebieg" value="@(_selected?.ToString() ?? "")" @onchange="SelectRun">
                <option value="">Na żywo</option>
                @foreach (var run in Archive.List())
                { <option value="@run.Id">@(run.Alias ?? run.Name) · @run.Result</option> }
            </select>
            <button @onclick="TogglePlay" disabled="@(_view is null || _live)">@(_playing ? "Pauza" : "Play")</button>
            @foreach (var speed in new[] { 1, 2, 4 })
            { <button class="@(_speed == speed ? "selected" : "")" @onclick="() => SetSpeed(speed)">@(speed)×</button> }
            <button @onclick="GoLive">Na żywo</button>
        </div>
    </header>
    @foreach (var error in Archive.Errors) { <p role="alert">@error</p> }
    @if (_view is { } view)
    {
        <div class="run-details">
            <strong>@view.Info.Name</strong><span>@view.Info.Result</span>
            <label>Alias <input maxlength="120" @bind="_alias" @bind:event="oninput" /></label><button @onclick="SaveAlias">Zapisz alias</button>
            <span>@view.Info.Start.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") · @Elapsed(Duration) czasu przebiegu</span>
            @if (view.Info.StorageError is { } error) { <p role="alert">@error</p> }
        </div>
    }
    else { <p>Brak uruchomionego testu. Wybierz zapisany przebieg lub uruchom Deploy.</p> }
    <div class="legend">
        <label><input type="checkbox" @bind="_requests" /> <i class="request-dot"></i> Requesty/s</label>
        <label><input type="checkbox" @bind="_errors" /> <i class="error-dot"></i> Błędy/s</label>
        <span>▏ początek / koniec deployu</span><span>● skalowanie</span><span class="muted">Repliki: zielona = Ready, przerywana = cel</span><span class="muted">Czas od tworzenia namespace’a · przerwy = brak pomiaru</span>
    </div>
    <div class="plot-scroll">
        <div class="plot-body" @ref="_plot">
            <svg viewBox="0 0 1000 @MainHeight" role="img" aria-label="Ruch, procent błędów i gotowe repliki w czasie">
                <rect x="180" y="12" width="800" height="150" class="plot-bg" />
                <rect x="180" y="190" width="800" height="60" class="plot-bg" />
                @for (var index = 0; index < DeploymentGroups.Length; index++)
                { <rect x="180" y="@(280 + index * 85)" width="800" height="60" class="plot-bg" /> }
                @foreach (var gap in _data.Gaps.Where(g => g.Start <= _end && (g.End ?? _end) >= Start))
                { <rect x="@F(X(gap.Start))" y="12" width="@F(Width(gap.Start, gap.End))" height="@(MainHeight - 42)" class="gap"><title>@gap.Source: przerwa obserwacji</title></rect> }
                @foreach (var rollout in VisibleRollouts)
                {
                    <rect x="@F(X(rollout.Start))" y="12" width="@F(Math.Max(1, Width(rollout.Start, rollout.End)))" height="@(MainHeight - 42)" class="rollout-band"><title>@RolloutTitle(rollout)</title></rect>
                    @if (rollout.Start >= Start) { <line x1="@F(X(rollout.Start))" x2="@F(X(rollout.Start))" y1="12" y2="@(MainHeight - 30)" class="deploy-line"><title>@RolloutTitle(rollout) · początek</title></line> }
                    @if (rollout.End is { } end && end <= _end) { <line x1="@F(X(end))" x2="@F(X(end))" y1="12" y2="@(MainHeight - 30)" class="deploy-end"><title>@RolloutTitle(rollout) · koniec</title></line> }
                }
                @foreach (var evt in VisibleEvents.Where(e => e.Kind == "Skalowanie"))
                { <circle cx="@F(X(evt.Time))" cy="175" r="4" class="scale-event"><title>@evt.Time.ToString("HH:mm:ss") · @evt.Name · @evt.Details</title></circle> }
                @for (var i = 0; i <= 4; i++)
                {
                    var x = 180 + 200 * i;
                    <line x1="@x" x2="@x" y1="12" y2="@(MainHeight - 30)" class="grid" />
                    <g><text x="@x" y="@(MainHeight - 8)" text-anchor="@(i == 0 ? "start" : i == 4 ? "end" : "middle")">@Elapsed(Duration * i / 4d)</text></g>
                }
                <g><text x="12" y="35" class="chart-label">Ruch / s</text><text x="12" y="57">@TrafficMax.ToString("0.##") max</text><text x="167" y="160" text-anchor="end">0</text></g>
                @if (_requests) { <path d="@TrafficPath(false, false)" class="request-line" /> }
                @if (_errors) { <path d="@TrafficPath(true, false)" class="error-line" /> }
                @if (!VisibleTraffic.Any()) { <g><text x="580" y="92" text-anchor="middle" class="empty-label">Brak pomiaru k6 w tym zakresie</text></g> }
                <g><text x="12" y="212" class="chart-label">Błędy / requesty</text><text x="12" y="234">0–100%</text></g>
                <path d="@TrafficPath(true, true)" class="error-line" />
                @for (var index = 0; index < DeploymentGroups.Length; index++)
                {
                    var group = DeploymentGroups[index];
                    var top = 280 + index * 85;
                    var max = Math.Max(1, group.Max(p => Math.Max(p.Ready, p.Desired)));
                    <g><text x="12" y="@(top + 20)" class="chart-label">@Short(group.First().Name)<title>@group.First().Name · @group.Key</title></text><text x="12" y="@(top + 42)">Repliki · 0–@max</text></g>
                    <path d="@ReplicaPath(group, top, max, true)" class="desired-line" />
                    <path d="@ReplicaPath(group, top, max, false)" class="ready-line" />
                }
                <line x1="@F(CursorX)" x2="@F(CursorX)" y1="12" y2="@(MainHeight - 30)" class="cursor-line" />
            </svg>
            <div class="pod-heading">CYKL ŻYCIA PODÓW <span>Ready · Running bez gotowości · Pending · Terminating · zakończony</span></div>
            <div class="pod-scroll">
                <svg viewBox="0 0 1000 @Math.Max(40, PodRows.Length * 32)" role="img" aria-label="Stany podów w czasie">
                    @for (var i = 0; i <= 4; i++)
                    { <line x1="@(180 + 200 * i)" x2="@(180 + 200 * i)" y1="0" y2="@Math.Max(40, PodRows.Length * 32)" class="grid" /> }
                    @foreach (var rollout in VisibleRollouts)
                    {
                        <rect x="@F(X(rollout.Start))" y="0" width="@F(Math.Max(1, Width(rollout.Start, rollout.End)))" height="@Math.Max(40, PodRows.Length * 32)" class="rollout-band" />
                        @if (rollout.Start >= Start) { <line x1="@F(X(rollout.Start))" x2="@F(X(rollout.Start))" y1="0" y2="@Math.Max(40, PodRows.Length * 32)" class="deploy-line" /> }
                        @if (rollout.End is { } end && end <= _end) { <line x1="@F(X(end))" x2="@F(X(end))" y1="0" y2="@Math.Max(40, PodRows.Length * 32)" class="deploy-end" /> }
                    }
                    @for (var index = 0; index < PodRows.Length; index++)
                    {
                        var row = PodRows[index];
                        var y = index * 32;
                        <g><text x="12" y="@(y + 13)" class="pod-name">@Short(row.First().Name)<title>@row.First().Deployment / @row.First().ReplicaSet / @row.First().Name · @row.Key</title></text><text x="12" y="@(y + 26)" class="pod-owner">@Short(row.First().Deployment) / @Short(row.First().ReplicaSet)</text></g>
                        <line x1="180" x2="980" y1="@(y + 28)" y2="@(y + 28)" class="grid" />
                        @foreach (var interval in row)
                        { <rect x="@F(X(interval.Start))" y="@(y + 5)" width="@F(Math.Max(.8, Width(interval.Start, interval.End)))" height="20" rx="2" class="pod-state @StateClass(interval.State)"><title>@interval.Name · @interval.State · @interval.Start.ToString("HH:mm:ss") UTC · @interval.Details</title></rect> }
                        @foreach (var deleted in _data.Events.Where(e => e.Kind == "Usunięcie" && e.Details == row.Key && e.Time >= Start && e.Time <= _end))
                        { <line x1="@F(X(deleted.Time))" x2="@F(X(deleted.Time))" y1="@y" y2="@(y + 28)" class="error-line"><title>Usunięto @deleted.Name</title></line> }
                    }
                    <line x1="@F(CursorX)" x2="@F(CursorX)" y1="0" y2="@Math.Max(40, PodRows.Length * 32)" class="cursor-line" />
                    @if (PodRows.Length == 0) { <g><text x="580" y="25" text-anchor="middle">Brak obserwacji podów w tym zakresie</text></g> }
                </svg>
            </div>
        </div>
    </div>
    <label class="cursor-control">Kursor czasu <input type="range" min="0" max="1000" step="1" disabled="@_live" value="@_cursor" @oninput="MoveCursor" /></label>
    <div class="readout">
        <strong>@CursorTime.ToString("HH:mm:ss") UTC</strong>
        @if (CursorTraffic is { } point)
        { <span>Requesty/s <b>@point.RequestsPerSecond.ToString("0.##")</b></span><span>Błędy/s <b>@point.ErrorsPerSecond.ToString("0.##")</b></span><span>Błędy <b>@(point.ErrorPercent?.ToString("0.##") + (point.ErrorPercent is null ? "—" : "%"))</b></span> }
        else { <span>Brak pomiaru ruchu</span> }
        @if (_view?.Entries.LastOrDefault(e => e.Time <= CursorTime && e.Progress is not null)?.Progress is { } load)
        {
            <span>@load.Phase</span><span>Requesty <b>@load.Requests.ToString("N0")</b></span>
            <span>Nieudane checks <b>@load.FailedChecks.ToString("N0")</b></span><span>p95 <b>@load.P95.ToString("N1") ms</b></span>
        }
        @foreach (var group in DeploymentGroups)
        {
            var replica = group.LastOrDefault(p => p.Time <= CursorTime);
            <span>@group.First().Name <b>@(replica is { Known: true } ? $"{replica.Ready}/{replica.Desired} Ready" : "brak obserwacji")</b></span>
        }
        @foreach (var row in PodRows)
        {
            var pod = row.LastOrDefault(p => p.Start <= CursorTime && (p.End ?? _end) >= CursorTime);
            <span>@row.First().Name <b>@(pod?.State ?? "brak obserwacji")</b></span>
        }
        @foreach (var rollout in VisibleRollouts.Where(r => r.Start <= CursorTime && (r.End ?? _end) >= CursorTime))
        { <span>@rollout.Name · @rollout.Image · @rollout.Result</span> }
    </div>
    <details class="events"><summary>Zdarzenia w zakresie (@VisibleEvents.Length)</summary>
        @foreach (var evt in VisibleEvents.Reverse()) { <div><time>@evt.Time.ToString("HH:mm:ss")</time> <b>@evt.Kind</b> · @evt.Name · @evt.Details</div> }
    </details>
</section>

@code {
    private TimelineSnapshot _data = new([], [], [], [], [], []);
    private DateTimeOffset _end = DateTimeOffset.UtcNow;
    private DateTimeOffset _start = DateTimeOffset.UtcNow;

    private bool _live = true, _requests = true, _errors = true, _disposed;
    private double _cursor = 1000;
    private ElementReference _plot;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DeploymentTimeline>? _reference;
    [Parameter] public EventCallback<RunFrame?> FrameChanged { get; set; }
    private Guid? _selected;
    private RunView? _view;
    private string? _alias;
    private bool _playing;
    private int _speed = 1;
    private readonly CancellationTokenSource _stop = new();
    private Task? _clock;
    private long _lastTick;
    private DateTimeOffset _lastRefresh;
    private DateTimeOffset Start => _start;
    private double Duration => Math.Max(0, (_end - Start).TotalSeconds);
    private DateTimeOffset CursorTime => Start.AddSeconds(Duration * _cursor / 1000);
    private static string Elapsed(double seconds) => TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(@"hh\:mm\:ss");
    private double CursorX => 180 + .8 * _cursor;
    private IEnumerable<TrafficPoint> VisibleTraffic => _data.Traffic.Where(p => p.End >= Start && p.Start <= _end);
    private TrafficPoint? CursorTraffic => VisibleTraffic.LastOrDefault(p => p.Start <= CursorTime && p.End >= CursorTime);
    private IEnumerable<RolloutInterval> VisibleRollouts => _data.Rollouts.Where(p => p.Start <= _end && (p.End ?? _end) >= Start);
    private IGrouping<string, ReplicaPoint>[] DeploymentGroups => _data.Replicas.Where(p => p.Time <= _end).GroupBy(p => p.Uid).Where(g => g.Any(p => p.Time >= Start) || g.Last().Known).OrderBy(g => g.First().Name).ToArray();
    private IGrouping<string, PodInterval>[] PodRows => _data.Pods.Where(p => p.Start <= _end && (p.End ?? _end) >= Start).GroupBy(p => p.Uid).OrderBy(g => g.Last().Deployment).ThenBy(g => g.Last().ReplicaSet).ThenBy(g => g.First().Start).ToArray();
    private TimelineEvent[] VisibleEvents => _data.Events.Where(e => e.Time >= Start && e.Time <= _end).ToArray();
    private int MainHeight => 290 + DeploymentGroups.Length * 85;
    private double TrafficMax => Math.Max(1, VisibleTraffic.Select(p => Math.Max(_requests ? p.RequestsPerSecond : 0, _errors ? p.ErrorsPerSecond : 0)).DefaultIfEmpty(1).Max());
    private double X(DateTimeOffset time) => 180 + Math.Clamp((time - Start).TotalSeconds / Math.Max(.001, Duration), 0, 1) * 800;
    private double Width(DateTimeOffset start, DateTimeOffset? end) => Math.Max(0, X(end ?? _end) - X(start));
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Short(string name) => name.Length <= 23 ? name : name[..20] + "…";
    private static string StateClass(string state) => state switch { "Ready" => "ready", "NotReady" => "not-ready", "Pending" => "pending", "Terminating" => "terminating", _ => "ended" };
    private static string RolloutTitle(RolloutInterval r) => $"{r.Name} · {r.Image} · {r.Result} · {(r.TestId is null ? "zewnętrzny" : $"test {r.TestId:N}")}";

    private string TrafficPath(bool errors, bool percent)
    {
        var path = new System.Text.StringBuilder();
        DateTimeOffset? previousEnd = null;
        Guid? previousId = null;
        foreach (var p in VisibleTraffic)
        {
            var value = percent ? p.ErrorPercent : errors ? p.ErrorsPerSecond : p.RequestsPerSecond;
            if (value is null) { previousEnd = null; continue; }
            var y = percent ? 250 - Math.Clamp(value.Value, 0, 100) * .6 : 162 - value.Value / TrafficMax * 145;
            path.Append($"{(previousEnd == p.Start && previousId == p.TestId ? "L" : "M")}{F(X(p.Start))},{F(y)} L{F(X(p.End))},{F(y)} ");
            previousEnd = p.End;
            previousId = p.TestId;
        }
        return path.ToString();
    }
    private string ReplicaPath(IEnumerable<ReplicaPoint> source, int top, int max, bool desired)
    {
        var points = source.ToArray();
        var path = new System.Text.StringBuilder();
        for (var i = 0; i < points.Length; i++)
        {
            var p = points[i];
            var end = i + 1 < points.Length ? points[i + 1].Time : _end;
            if (!p.Known || end < Start) continue;
            var y = top + 60 - (desired ? p.Desired : p.Ready) * 55d / max;
            path.Append($"M{F(X(p.Time))},{F(y)} H{F(X(end))} ");
            if (i + 1 < points.Length && points[i + 1].Known)
                path.Append($"V{F(top + 60 - (desired ? points[i + 1].Desired : points[i + 1].Ready) * 55d / max)} ");
        }
        return path.ToString();
    }
    protected override void OnInitialized()
    {
        RefreshData();
        _lastTick = System.Diagnostics.Stopwatch.GetTimestamp();
        _clock = ClockAsync();
    }
    private void RefreshData()
    {
        var id = _live ? Archive.ActiveId : _selected;
        _view = id is { } value ? Archive.Get(value) : null;
        _data = _view?.Timeline ?? new([], [], [], [], [], []);
        _start = _view?.Info.Start ?? DateTimeOffset.UtcNow;
        _end = _view?.Info.End ?? DateTimeOffset.UtcNow;
        if (_live) _cursor = 1000;
    }
    private async Task ClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(async () =>
                {
                    var now = System.Diagnostics.Stopwatch.GetTimestamp();
                    var elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(_lastTick, now).TotalSeconds;
                    _lastTick = now;
                    if (_disposed) return;
                    if (_live && DateTimeOffset.UtcNow - _lastRefresh >= TimeSpan.FromSeconds(1))
                    { RefreshData(); _lastRefresh = DateTimeOffset.UtcNow; }
                    if (_playing)
                    {
                        _cursor = Math.Min(1000, _cursor + elapsed * _speed / Math.Max(.001, Duration) * 1000);
                        if (_cursor >= 1000) _playing = false;
                        await PublishFrame();
                    }
                    if (_live || _playing || _cursor >= 1000) StateHasChanged();
                });
        }
        catch (OperationCanceledException) { }
    }
    private Task PublishFrame() => FrameChanged.InvokeAsync(_live ? null :
        _view?.Frames.LastOrDefault(f => f.Time <= CursorTime) ?? new RunFrame(CursorTime, new([], false, null), new([], false, null), new([], false, null)));
    private async Task SelectRun(ChangeEventArgs e)
    {
        _selected = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _live = _selected is null;
        _playing = false;
        _speed = 1;
        RefreshData();
        _cursor = _live ? 1000 : 0;
        _alias = _view?.Info.Alias;
        await PublishFrame();
    }
    private async Task GoLive() => await SelectRun(new ChangeEventArgs { Value = "" });
    private void TogglePlay()
    {
        if (_cursor >= 1000) _cursor = 0;
        _lastTick = System.Diagnostics.Stopwatch.GetTimestamp();
        _playing = !_playing;
    }
    private void SetSpeed(int speed) { _speed = speed; _lastTick = System.Diagnostics.Stopwatch.GetTimestamp(); }
    private void SaveAlias()
    {
        if (_view is not null) { Archive.Alias(_view.Info.Id, _alias); RefreshData(); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/DeploymentTimeline.razor.js");
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attach", _plot, _reference);
    }
    private async Task MoveCursor(ChangeEventArgs args)
    { if (double.TryParse(args.Value?.ToString(), out var value)) await SetCursor(value); }
    [JSInvokable] public Task SetCursor(double value) => InvokeAsync(async () =>
    {
        if (_disposed || _live) return;
        _playing = false;
        _cursor = Math.Clamp(value, 0, 1000);
        await PublishFrame();
        StateHasChanged();
    });
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _stop.Cancel();
        if (_clock is not null) await _clock;
        _stop.Dispose();
        if (_module is not null)
            try { await _module.InvokeVoidAsync("detach", _plot); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
